# ============================================================
# SaborExpress API — Variables de entorno
# ============================================================

# --- Base de datos ---
# Producción (PostgreSQL, según el documento de arquitectura):
# DATABASE_URL=postgresql+psycopg2://sabor:sabor@saborexpress-db:5432/saborexpress
# Desarrollo local sin PostgreSQL (SQLite, arranca de inmediato):
DATABASE_URL=sqlite:///./saborexpress.db

# --- Seguridad ---
SECRET_KEY=cambia-esta-clave-en-produccion-por-una-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3
REMEMBER_TOKEN_EXPIRE_DAYS=7

# --- Reglas de negocio ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MAX_TRANSACTION_SECONDS=2
MAX_CONCURRENT_USERS=20

# --- CORS ---
CORS_ORIGINS=*
